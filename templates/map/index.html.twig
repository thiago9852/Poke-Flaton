                <div class="portal-popup">
                    <h4>${portal.targetMapName}</h4>
                    <p>Clique abaixo para entrar nesta área especial.</p>
                    <button class="btn btn-primary btn-sm" onclick="openSubmapModal(${portal.targetMapId})">
                        <i class="fa-solid fa-door-open"></i> Entrar
                    </button>
            `;

            if (portal.canDelete) {
                popupContent += `
                    <button class="btn-popup-delete" onclick="deletePortal(${portal.id}, '${portal.csrfToken}', true)">
                        <i class="fa-solid fa-trash-can"></i> Excluir Portal
                    </button>
                `;
            }

            popupContent += `
