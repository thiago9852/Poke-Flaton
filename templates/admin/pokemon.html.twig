{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | Pokémon Master Mov Set{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/trainer-card.css') }}">
	<link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
	<!-- Dashboard Shell -->
	<div class="dash-shell">

		<!-- Overlay Mobile Sidebar -->
		<div class="dash-sidebar-overlay" id="dash-sidebar-overlay" onclick="closeMobileSidebar()"></div>

		<!-- Dashboard Sidebar Navigation -->
		<aside class="dash-sidebar" id="dash-sidebar">
			<div class="dash-sidebar-brand">
				<div class="dash-brand-icon">
					<i class="fa-solid fa-chart-line"></i>
				</div>
				<div class="dash-brand-text">
					<h3>PAINEL ADMIN</h3>
					<span>Pokémon Master Mov Set</span>
				</div>
			</div>

			<nav class="dash-nav">
				<div class="dash-nav-group-title">Navegação Principal</div>
				
				<button type="button" class="dash-nav-item {{ activeTab == 'overview' or activeTab not in ['locations', 'movesets', 'variations', 'evolutions', 'basemoves', 'gamification'] ? 'active' : '' }}" id="nav-overview" onclick="switchDashTab('overview')">
					<div class="dash-nav-item-left">
						<i class="fa-solid fa-house"></i>
						<span>Visão Geral</span>
					</div>
				</button>

				<button type="button" class="dash-nav-item {{ activeTab in ['locations', 'users', 'games'] ? 'active' : '' }}" id="nav-locations" onclick="switchDashTab('locations')">
					<div class="dash-nav-item-left">
						<i class="fa-solid fa-map-location-dot"></i>
						<span>Localizações</span>
					</div>
					{% if stats.pendingLocations > 0 %}
						<span class="dash-nav-badge">{{ stats.pendingLocations }}</span>
					{% endif %}
				</button>

				<button type="button" class="dash-nav-item {{ activeTab == 'movesets' ? 'active' : '' }}" id="nav-movesets" onclick="switchDashTab('movesets')">
					<div class="dash-nav-item-left">
						<i class="fa-solid fa-wand-magic-sparkles"></i>
						<span>Movesets</span>
					</div>
					{% if stats.pendingMovesets > 0 %}
						<span class="dash-nav-badge">{{ stats.pendingMovesets }}</span>
					{% endif %}
				</button>

				<div class="dash-nav-group-title">Dados de Pokémon</div>

				<button type="button" class="dash-nav-item {{ activeTab == 'variations' ? 'active' : '' }}" id="nav-variations" onclick="switchDashTab('variations')">
					<div class="dash-nav-item-left">
						<i class="fa-solid fa-dna"></i>
						<span>Variações</span>
					</div>
					<span class="dash-nav-badge neutral">{{ stats.variations }}</span>
				</button>

				<button type="button" class="dash-nav-item {{ activeTab == 'evolutions' ? 'active' : '' }}" id="nav-evolutions" onclick="switchDashTab('evolutions')">
					<div class="dash-nav-item-left">
						<i class="fa-solid fa-bolt"></i>
						<span>Regras Evolutivas</span>
					</div>
					<span class="dash-nav-badge neutral">{{ stats.evolutionRules }}</span>
				</button>

				<button type="button" class="dash-nav-item {{ activeTab == 'basemoves' ? 'active' : '' }}" id="nav-basemoves" onclick="switchDashTab('basemoves')">
					<div class="dash-nav-item-left">
						<i class="fa-solid fa-bullseye"></i>
						<span>Golpes Base</span>
					</div>
					<span class="dash-nav-badge neutral">{{ stats.defaultBaseMoves }}</span>
				</button>

				<div class="dash-nav-group-title">Sistema & Gamificação</div>

				<button type="button" class="dash-nav-item {{ activeTab == 'gamification' ? 'active' : '' }}" id="nav-gamification" onclick="switchDashTab('gamification')">
					<div class="dash-nav-item-left">
						<i class="fa-solid fa-palette"></i>
						<span>Gamificação & Cards</span>
					</div>
				</button>
			</nav>
		</aside>

		<!-- Dashboard Main Area -->
		<main class="dash-main">

			<!-- Header Superior com Ações Rápidas -->
			<div class="dash-header-bar">
				<div class="dash-header-title">
					<button class="dash-mobile-toggle" onclick="toggleMobileSidebar()" aria-label="Abrir Menu">
						<i class="fa-solid fa-bars"></i>
					</button>
					<div>
						<h1 id="dash-header-title-text">Visão Geral & Dashboard</h1>
						<p>Gerenciamento em tempo real do sistema Pokémon Master Mov Set</p>
					</div>
				</div>

				<div class="dash-header-actions">
					<form method="post" action="{{ path('app_admin_clear_cache') }}" onsubmit="return confirm('Deseja realmente limpar o cache de produção do Symfony?')">
						<input type="hidden" name="_token" value="{{ csrf_token('admin-clear-cache') }}">
						<button type="submit" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); padding: 8px 16px; font-size: 0.85rem;" title="Limpa o cache de templates do Symfony">
							<i class="fa-solid fa-broom"></i>
							<span>Limpar Cache</span>
						</button>
					</form>
				</div>
			</div>

			<!-- Flashes Alert Notifications -->
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert alert-{{ label == 'error' ? 'error' : 'success' }}" style="margin: 0; border-radius: 12px;">
						<i class="fa-solid {{ label == 'error' ? 'fa-circle-exclamation' : 'fa-circle-check' }}"></i>
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}

			<!-- ===================================================================
			     ABA 1: VISÃO GERAL (OVERVIEW)
			     =================================================================== -->
			<div class="dash-panel" id="panel-overview">
				<!-- KPI Stat Cards -->
				<div class="kpi-grid">
					<div class="kpi-card" onclick="switchDashTab('locations')">
						<div class="kpi-icon amber">
							<i class="fa-solid fa-map-pin"></i>
						</div>
						<div class="kpi-data">
							<div class="kpi-value">{{ stats.pendingLocations }}</div>
							<div class="kpi-label">Locais Pendentes</div>
						</div>
					</div>

					<div class="kpi-card" onclick="switchDashTab('movesets')">
						<div class="kpi-icon rose">
							<i class="fa-solid fa-wand-magic-sparkles"></i>
						</div>
						<div class="kpi-data">
							<div class="kpi-value">{{ stats.pendingMovesets }}</div>
							<div class="kpi-label">Movesets Pendentes</div>
						</div>
					</div>

					<div class="kpi-card" onclick="switchDashTab('locations')">
						<div class="kpi-icon emerald">
							<i class="fa-solid fa-circle-check"></i>
						</div>
						<div class="kpi-data">
							<div class="kpi-value">{{ stats.approvedLocations }}</div>
							<div class="kpi-label">Locais Aprovados</div>
						</div>
					</div>

					<div class="kpi-card" onclick="switchDashTab('movesets')">
						<div class="kpi-icon indigo">
							<i class="fa-solid fa-chess-board"></i>
						</div>
						<div class="kpi-data">
							<div class="kpi-value">{{ stats.totalMovesets }}</div>
							<div class="kpi-label">Total de Movesets</div>
						</div>
					</div>

					<div class="kpi-card" onclick="switchDashTab('variations')">
						<div class="kpi-icon purple">
							<i class="fa-solid fa-dna"></i>
						</div>
						<div class="kpi-data">
							<div class="kpi-value">{{ stats.variations }}</div>
							<div class="kpi-label">Variações Cadastradas</div>
						</div>
					</div>

					<div class="kpi-card" onclick="switchDashTab('evolutions')">
						<div class="kpi-icon emerald">
							<i class="fa-solid fa-bolt"></i>
						</div>
						<div class="kpi-data">
							<div class="kpi-value">{{ stats.evolutionRules }}</div>
							<div class="kpi-label">Regras Evolutivas</div>
						</div>
					</div>
				</div>

				<!-- Quick Actions & Summaries Grid -->
				<div class="overview-actions-grid">
					<!-- Card Atalho 1: Moderação Pendente -->
					<div class="action-card">
						<div class="action-card-header">
							<i class="fa-solid fa-clipboard-check"></i>
							<h3>Moderação Pendente</h3>
						</div>
						<p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
							Existem <strong>{{ stats.pendingLocations }}</strong> sugestões de localizações e <strong>{{ stats.pendingMovesets }}</strong> sugestões de movesets aguardando sua revisão.
						</p>
						<div style="display: flex; gap: 10px; margin-top: auto; flex-wrap: wrap;">
							<button type="button" onclick="switchDashTab('locations')" class="btn btn-primary" style="flex: 1; padding: 10px; font-size: 0.85rem; justify-content: center;">
								<i class="fa-solid fa-map-location-dot"></i>
								Revisar Locais
							</button>
							<button type="button" onclick="switchDashTab('movesets')" class="btn btn-secondary" style="flex: 1; padding: 10px; font-size: 0.85rem; justify-content: center;">
								<i class="fa-solid fa-wand-magic-sparkles"></i>
								Revisar Movesets
							</button>
						</div>
					</div>

					<!-- Card Atalho 2: Estatísticas Globais -->
					<div class="action-card">
						<div class="action-card-header">
							<i class="fa-solid fa-sliders"></i>
							<h3>Configurações de Dados</h3>
						</div>
						<ul style="font-size: 0.85rem; color: var(--text-secondary); margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px;">
							<li><strong>{{ stats.defaultBaseMoves }}</strong> Pokémon possuem Golpes Base Padrão configurados.</li>
							<li><strong>{{ stats.cardTemplates }}</strong> Templates de Plano de Fundo disponíveis.</li>
							<li><strong>{{ stats.avatars }}</strong> Avatares cadastrados no banco de dados.</li>
						</ul>
						<div style="margin-top: auto;">
							<button type="button" onclick="switchDashTab('gamification')" class="btn btn-secondary" style="width: 100%; padding: 10px; font-size: 0.85rem; justify-content: center;">
								<i class="fa-solid fa-palette"></i>
								Gerenciar Gamificação
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- ===================================================================
			     ABA 2: LOCALIZAÇÕES
			     =================================================================== -->
			<div class="dash-panel" id="panel-locations">
				<div class="admin-card-container padded mb-15">
					<h3 class="admin-section-title mb-15">
						<i class="fa-solid fa-file-import color-primary-icon"></i>
						Importação de Localizações em Lote via JSON
					</h3>
					<p class="text-muted" style="font-size: 0.85rem; margin-bottom: 16px; color: var(--text-muted);">
						Envie um arquivo <code>.json</code> contendo uma lista de localizações de Pokémon.
					</p>
					
					<form method="post" action="{{ path('app_admin_import_resource', {'resource': 'locations'}) }}" enctype="multipart/form-data">
						<div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
							<div style="flex: 1; min-width: 250px;">
								<input type="file" name="import_file" accept=".json" class="form-input" required style="padding: 8px;">
							</div>
							<button type="submit" class="btn btn-primary">
								<i class="fa-solid fa-upload"></i>
								Importar Localizações
							</button>
						</div>
					</form>
				</div>

				<!-- Sub-Abas Localizações -->
				<div class="admin-tabs">
					<a href="{{ path('app_admin_pokemon', {'tab': 'users'}) }}#panel-locations" class="admin-tab-btn {{ activeTab != 'games' ? 'active' : '' }}">
						<i class="fa-solid fa-user-pen"></i>
						Sugestões dos Usuários ({{ pendingLocations|length }})
					</a>
					<a href="{{ path('app_admin_pokemon', {'tab': 'games'}) }}#panel-locations" class="admin-tab-btn {{ activeTab == 'games' ? 'active' : '' }}">
						<i class="fa-solid fa-gamepad"></i>
						Jogos Oficiais (PokéAPI)
					</a>
				</div>

				{% if activeTab != 'games' %}
					<!-- Aba Sugestões dos Usuários -->
					{% if pendingLocations is empty %}
						<div class="admin-empty-placeholder">
							<i class="fa-solid fa-circle-check success-icon"></i>
							Nenhuma sugestão de localização pendente de validação!
						</div>
					{% else %}
						{% for location in pendingLocations %}
							<form id="approve-form-{{ location.id }}" method="post" action="{{ path('app_location_approve', {'id': location.id, 'redirect': 'admin'}) }}"></form>
							<form id="delete-form-{{ location.id }}" method="post" action="{{ path('app_location_delete', {'id': location.id, 'redirect': 'admin'}) }}" onsubmit="return confirm('Deseja realmente rejeitar esta localização?')"></form>
						{% endfor %}

						<form id="bulkActionForm" method="post" action="{{ path('app_location_bulk') }}">
							<div class="admin-card-container overflow-hidden">
								<div class="table-bulk-header">
									<div class="table-bulk-header-selection">
										<label class="bulk-select-label">
											<input type="checkbox" id="selectAllSuggestions" class="admin-checkbox">
											Selecionar Tudo
										</label>
									</div>
									<div class="table-bulk-actions">
										<button type="submit" name="action" value="approve" class="btn-bulk-action approve">
											<i class="fa-solid fa-check-double"></i>
											Aprovar Selecionados
										</button>
										<button type="submit" name="action" value="delete" class="btn-bulk-action delete" onclick="return confirm('Deseja realmente rejeitar as sugestões selecionadas?')">
											<i class="fa-solid fa-trash-can"></i>
											Rejeitar Selecionados
										</button>
									</div>
								</div>

								<table class="admin-table">
									<thead>
										<tr>
											<th class="checkbox-col"></th>
											<th>Pokémon</th>
											<th>Localização Sugerida</th>
											<th>Data de Envio</th>
											<th class="text-right">Ações</th>
										</tr>
									</thead>
									<tbody>
										{% for location in pendingLocations %}
											<tr>
												<td class="checkbox-col">
													<input type="checkbox" name="ids[]" value="{{ location.id }}" class="suggestion-checkbox admin-checkbox">
												</td>
												<td class="font-bold">
													<a href="{{ path('app_pokemon_detail', {'name': location.pokemonName}) }}" class="admin-table-link" target="_blank">
														<i class="fa-solid fa-circle-chevron-right"></i>
														{{ location.pokemonName|capitalize }}
													</a>
												</td>
												<td>{{ location.locationName }}</td>
												<td class="text-muted-small">{{ location.createdAt|date('d/m/Y H:i') }}</td>
												<td class="text-right">
													<div class="table-actions-cell-wrapper">
														<button type="submit" form="approve-form-{{ location.id }}" class="btn-admin-approve">
															<i class="fa-solid fa-check"></i> Aprovar
														</button>
														<button type="submit" form="delete-form-{{ location.id }}" class="btn-admin-reject">
															<i class="fa-solid fa-xmark"></i> Rejeitar
														</button>
													</div>
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						</form>
					{% endif %}
				{% else %}
					<!-- Aba Jogos Oficiais -->
					<div class="game-search-box">
						<form method="get" action="{{ path('app_admin_pokemon') }}#panel-locations" class="game-search-form">
							<input type="hidden" name="tab" value="games">
							<div class="game-search-input-wrapper">
								<label>Buscar Pokémon nos Jogos Oficiais</label>
								<input type="text" name="pokemon" value="{{ pokemonSearch }}" class="game-search-input" placeholder="Ex: Pikachu, Charizard..." list="pokemon-search-list" autocomplete="off" required>
								<datalist id="pokemon-search-list">
									{% for poke in pokemonList %}
										<option value="{{ poke.name }}">{{ poke.name|capitalize }}</option>
									{% endfor %}
								</datalist>
							</div>
							<button type="submit" class="btn btn-primary btn-search-submit">
								<i class="fa-solid fa-magnifying-glass"></i> Buscar
							</button>
						</form>
					</div>

					{% if pokemonSearch is not empty %}
						<div class="admin-card-container padded">
							<div class="game-import-header">
								<h3 class="admin-section-title">
									<i class="fa-solid fa-earth-americas color-secondary-icon"></i>
									Localizações de Encontro de {{ pokemonSearch|capitalize }} (PokéAPI)
								</h3>
								{% if gameEncounters is not empty %}
									<a href="{{ path('app_pokemon_detail', {'name': pokemonSearch}) }}" target="_blank" class="admin-view-pokemon-link">
										Ver Pokémon <i class="fa-solid fa-arrow-up-right-from-square"></i>
									</a>
								{% endif %}
							</div>

							{% if gameEncounters is empty %}
								<div class="admin-empty-placeholder">
									<i class="fa-solid fa-circle-info info-icon"></i>
									Nenhuma localização oficial encontrada na API para "{{ pokemonSearch }}" ou o Pokémon não possui encontros selvagens registrados.
								</div>
							{% else %}
								<form method="post" action="{{ path('app_location_import_official') }}">
									<input type="hidden" name="pokemonName" value="{{ pokemonSearch }}">
									<div class="game-loc-import-bar">
										<label class="bulk-select-label">
											<input type="checkbox" id="selectAllGameLocs" class="admin-checkbox">
											Selecionar Todas
										</label>
										<button type="submit" class="btn-admin-import">
											Importar Selecionadas
										</button>
									</div>
									<div class="game-loc-list-scroll">
										{% for enc in gameEncounters %}
											{% set fullLocName = enc.area ~ ' (' ~ enc.versions ~ ')' %}
											<div class="game-loc-row">
												<input type="checkbox" name="locations[]" value="{{ fullLocName }}" class="game-loc-checkbox admin-checkbox">
												<div class="flex-1">
													<div class="game-loc-name">{{ enc.area }}</div>
													<div class="game-loc-versions">
														<i class="fa-solid fa-gamepad"></i> {{ enc.versions }}
													</div>
												</div>
											</div>
										{% endfor %}
									</div>
								</form>
							{% endif %}
						</div>
					{% endif %}
				{% endif %}
			</div>

			<!-- ===================================================================
			     ABA 3: MOVESETS
			     =================================================================== -->
			<div class="dash-panel" id="panel-movesets">
				{% if pendingMovesets is empty %}
					<div class="admin-empty-placeholder">
						<i class="fa-solid fa-circle-check success-icon"></i>
						Nenhum moveset pendente de validação!
					</div>
				{% else %}
					<form id="bulkMovesetForm" method="post" action="{{ path('app_admin_moveset_bulk') }}">
						<div class="admin-card-container overflow-hidden">
							<div class="table-bulk-header">
								<div class="table-bulk-header-selection">
									<label class="bulk-select-label">
										<input type="checkbox" id="selectAllMovesets" class="admin-checkbox">
										Selecionar Tudo
									</label>
								</div>
								<div class="table-bulk-actions">
									<button type="submit" name="action" value="approve" class="btn-bulk-action approve">
										<i class="fa-solid fa-check-double"></i> Aprovar Selecionados
									</button>
									<button type="submit" name="action" value="delete" class="btn-bulk-action delete" onclick="return confirm('Deseja realmente rejeitar as sugestões selecionadas?')">
										<i class="fa-solid fa-trash-can"></i> Rejeitar Selecionadas
									</button>
								</div>
							</div>

							<table class="admin-table">
								<thead>
									<tr>
										<th class="checkbox-col"></th>
										<th>Pokémon</th>
										<th>Tipo</th>
										<th>Autor</th>
										<th>Nature / Habilidade / Item</th>
										<th>Golpes Recomendados</th>
										<th class="text-right" style="width: 200px;">Ações</th>
									</tr>
								</thead>
								<tbody>
									{% for m in pendingMovesets %}
										<form id="approve-moveset-form-{{ m.id }}" method="post" action="{{ path('app_admin_moveset_approve', {'id': m.id}) }}"></form>
										<form id="reject-moveset-form-{{ m.id }}" method="post" action="{{ path('app_admin_moveset_reject', {'id': m.id}) }}" onsubmit="return confirm('Deseja rejeitar a sugestão deste moveset como padrão?')"></form>

										<tr>
											<td class="checkbox-col">
												<input type="checkbox" name="ids[]" value="{{ m.id }}" class="moveset-checkbox admin-checkbox">
											</td>
											<td class="font-bold">
												<a href="{{ path('app_pokemon_detail', {'name': m.pokemonName}) }}" class="admin-table-link" target="_blank">
													<i class="fa-solid fa-circle-chevron-right"></i> {{ m.pokemonName|capitalize }}
												</a>
											</td>
											<td>
												<span class="badge bg-primary">
													{% if m.type == 'padrao' %}PADRÃO{% elseif m.type == 'pvp' %}PvP{% elseif m.type == 'dg' %}DG{% else %}{{ m.type|capitalize }}{% endif %}
												</span>
											</td>
											<td>{{ m.author|default('Anônimo') }}</td>
											<td>
												<span style="font-size: 0.85rem;">
													<strong>Nature:</strong> {{ m.nature|capitalize }}<br>
													<strong>Habilidade:</strong> {{ m.ability|default('Nenhuma')|capitalize }}<br>
													<strong>Item:</strong> {{ m.heldItem|default('Nenhum')|replace({'-': ' '})|title }}
												</span>
											</td>
											<td>
												<div style="display: flex; flex-wrap: wrap; gap: 4px;">
													{% for mv in m.moves %}
														{% if mv %}
															<span class="admin-hero-badge" style="background: rgba(255,255,255,0.08); color: #fff; font-size: 0.75rem; padding: 2px 6px;">
																{{ mv|replace({'-': ' '})|title }}
															</span>
														{% endif %}
													{% endfor %}
												</div>
											</td>
											<td class="text-right">
												<div class="table-actions-cell-wrapper" style="display: inline-flex; gap: 8px;">
													<button type="submit" form="approve-moveset-form-{{ m.id }}" class="btn-admin-approve" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 4px; height: auto;">
														<i class="fa-solid fa-check"></i> Aprovar
													</button>
													<button type="submit" form="reject-moveset-form-{{ m.id }}" class="btn-admin-reject" style="padding: 6px 12px; font-size: 0.8rem; border-radius: 4px; height: auto;">
														<i class="fa-solid fa-xmark"></i> Rejeitar
													</button>
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</form>
				{% endif %}
			</div>

			<!-- ===================================================================
			     ABA 4: VARIAÇÕES DE POKÉMON
			     =================================================================== -->
			<div class="dash-panel" id="panel-variations">
				<div class="admin-card-container padded">
					<h3 class="admin-section-title mb-15">
						Adicionar Nova Variação
					</h3>
					<form method="post" action="{{ path('app_admin_variation_add') }}">
						<div class="title-form-grid admin-grid-3">
							<div>
								<label class="title-form-label">ID da Variação (PokéAPI) *</label>
								<input type="number" name="variation_id" class="form-input" placeholder="Ex: 10003" min="1" required>
							</div>
							<div>
								<label class="title-form-label">ID Base (Pokémon original) *</label>
								<input type="number" name="base_id" class="form-input" placeholder="Ex: 412" min="1" required>
							</div>
							<div>
								<label class="title-form-label">Nome (slug PokéAPI) *</label>
								<input type="text" name="name" class="form-input" placeholder="Ex: burmy-trash" pattern="[a-z0-9\-]+" required>
							</div>
						</div>
						<div class="title-form-footer">
							<span class="text-muted" style="font-size: 0.8rem; color: var(--text-muted);">
								<i class="fa-solid fa-circle-info"></i> Verifique o ID correto em <a href="https://pokeapi.co/api/v2/pokemon/burmy-trash" target="_blank" style="color: var(--accent-primary);">pokeapi.co</a>
							</span>
							<button type="submit" class="btn btn-primary">
								<i class="fa-solid fa-plus"></i> Adicionar Variação
							</button>
						</div>
					</form>
				</div>

				<div class="admin-card-container padded">
					<h3 class="admin-section-title mb-15">Importação em Lote via JSON</h3>
					<form method="post" action="{{ path('app_admin_import_resource', {'resource': 'variations'}) }}" enctype="multipart/form-data">
						<div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
							<div style="flex: 1; min-width: 250px;">
								<input type="file" name="import_file" accept=".json" class="form-input" required style="padding: 8px;">
							</div>
							<button type="submit" class="btn btn-primary">
								<i class="fa-solid fa-upload"></i> Importar Variações
							</button>
						</div>
					</form>
				</div>

				<div class="admin-card-container padded">
					<input type="text" id="variation-search" onkeyup="filterVariations()" placeholder="Buscar por nome ou ID..." class="form-input" style="width: 100%;">
				</div>

				<div class="admin-card-container overflow-hidden">
					<table class="admin-table" id="variations-table">
						<thead>
							<tr>
								<th style="width: 60px;">Sprite</th>
								<th style="width: 100px;">ID Variação</th>
								<th style="width: 100px;">ID Base</th>
								<th>Nome (slug)</th>
								<th>Visualizar</th>
								<th class="text-right" style="width: 110px;">Ações</th>
							</tr>
						</thead>
						<tbody id="variations-tbody">
							{% for variation in variations %}
								{% set spriteUrl = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/' ~ variation.id ~ '.png' %}
								<tr class="variation-row" data-search="{{ variation.name }} {{ variation.id }} {{ variation.baseId }}">
									<td>
										<img src="{{ spriteUrl }}" alt="{{ variation.name }}" style="width: 40px; height: 40px; object-fit: contain; image-rendering: pixelated;" onerror="this.style.opacity='0.2'">
									</td>
									<td>
										<span class="admin-hero-badge" style="background: rgba(99,102,241,0.15); color: #818cf8;">#{{ variation.id }}</span>
									</td>
									<td>
										<span class="text-muted" style="font-size: 0.85rem;">#{{ variation.baseId }}</span>
									</td>
									<td>
										<strong>{{ variation.name }}</strong><br>
										<span class="text-muted" style="font-size: 0.75rem;">{{ variation.name|replace({'-': ' '})|title }}</span>
									</td>
									<td>
										<a href="{{ path('app_pokemon_detail', {'name': variation.name}) }}" target="_blank" class="admin-table-link" style="font-size: 0.85rem;">
											<i class="fa-solid fa-arrow-up-right-from-square"></i> Ver Pokémon
										</a>
									</td>
									<td class="text-right">
										<form method="post" action="{{ path('app_admin_variation_delete', {'id': variation.id}) }}" onsubmit="return confirm('Remover a variação &quot;{{ variation.name }}&quot;?')">
											<button type="submit" class="btn-admin-reject btn-sm" style="padding: 6px 12px; font-size: 0.8rem;">
												<i class="fa-solid fa-trash-can"></i> Remover
											</button>
										</form>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="6">
										<div class="admin-empty-placeholder">
											<i class="fa-solid fa-circle-info info-icon"></i>
											Nenhuma variação cadastrada.
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			<!-- ===================================================================
			     ABA 5: REGRAS DE EVOLUÇÃO
			     =================================================================== -->
			<div class="dash-panel" id="panel-evolutions">
				<div class="admin-card-container padded">
					<h3 class="admin-section-title mb-15">Associar Nova Evolução (Pedra/Sexo)</h3>
					<datalist id="evolution-pokemon-list">
						{% for pkm in pokemonList %}
							<option value="{{ pkm.name }}"></option>
						{% endfor %}
					</datalist>

					<form method="post" action="{{ path('app_admin_evolution_rule_add') }}">
						<div class="title-form-grid admin-grid-4">
							<div>
								<label class="title-form-label">Pokémon Base (Nome) *</label>
								<input type="text" name="base_pokemon" class="form-input" list="evolution-pokemon-list" placeholder="Ex: kirlia" required autocomplete="off">
							</div>
							<div>
								<label class="title-form-label">Pokémon Evoluído (Nome) *</label>
								<input type="text" name="evolved_pokemon" class="form-input" list="evolution-pokemon-list" placeholder="Ex: gallade" required autocomplete="off">
							</div>
							<div>
								<label class="title-form-label">Pedra Evolutiva *</label>
								<select name="evolution_stone" class="form-input" onchange="toggleCustomStoneField(this.value)" required>
									{% for stone in stones %}
										<option value="{{ stone.value }}" {% if stone.value == 'Dawn Stone' %}selected{% endif %}>{{ stone.getLabel() }}</option>
									{% endfor %}
									<option value="custom">Outra Pedra/Item...</option>
								</select>
								<input type="text" name="custom_stone" id="custom-stone-field" class="form-input" style="display: none; margin-top: 8px;" placeholder="Digite o nome do item...">
							</div>
							<div>
								<label class="title-form-label">Restrição de Gênero</label>
								<select name="gender" class="form-input">
									<option value="both" selected>Qualquer Sexo (Ambos)</option>
									<option value="male">Apenas Macho</option>
									<option value="female">Apenas Fêmea</option>
								</select>
							</div>
						</div>
						<div class="title-form-footer">
							<span class="text-muted" style="font-size: 0.8rem; color: var(--text-muted);">
								<i class="fa-solid fa-circle-info"></i> Substitui a lógica padrão de evolução na Pokédex.
							</span>
							<button type="submit" class="btn btn-primary">
								<i class="fa-solid fa-plus"></i> Associar Evolução
							</button>
						</div>
					</form>
				</div>

				<div class="admin-card-container padded">
					<h3 class="admin-section-title mb-15">Importação em Lote via JSON</h3>
					<form method="post" action="{{ path('app_admin_import_resource', {'resource': 'evolutions'}) }}" enctype="multipart/form-data">
						<div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
							<div style="flex: 1; min-width: 250px;">
								<input type="file" name="import_file" accept=".json" class="form-input" required style="padding: 8px;">
							</div>
							<button type="submit" class="btn btn-primary">
								<i class="fa-solid fa-upload"></i> Importar Regras
							</button>
						</div>
					</form>
				</div>

				<div class="admin-card-container padded">
					<input type="text" id="evolution-search" onkeyup="filterEvolutionRules()" placeholder="Buscar por Pokémon base, evoluído ou método..." class="form-input" style="width: 100%;">
				</div>

				<div class="admin-card-container overflow-hidden">
					<table class="admin-table" id="evolution-table">
						<thead>
							<tr>
								<th style="width: 60px;">Sprite</th>
								<th>Pokémon Base</th>
								<th style="width: 50px; text-align: center;"></th>
								<th style="width: 60px;">Sprite</th>
								<th>Pokémon Evoluído</th>
								<th>Método de Evolução</th>
								<th class="text-right" style="width: 110px;">Ações</th>
							</tr>
						</thead>
						<tbody id="evolution-tbody">
							{% for rule in evolutionRules %}
								{% set basePkm = pokemonByName[rule.basePokemon]|default(null) %}
								{% set evolvedPkm = pokemonByName[rule.evolvedPokemon]|default(null) %}
								{% set baseSprite = basePkm ? basePkm.sprite : 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/0.png' %}
								{% set evolvedSprite = evolvedPkm ? evolvedPkm.sprite : 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/0.png' %}
								
								<tr class="evolution-row" data-search="{{ rule.basePokemon }} {{ rule.evolvedPokemon }} {{ rule.method }} {% if rule.gender == 'male' %}macho{% elseif rule.gender == 'female' %}femea{% endif %}">
									<td><img src="{{ baseSprite }}" alt="{{ rule.basePokemon }}" style="width: 40px; height: 40px; object-fit: contain;" onerror="this.style.opacity='0.2'"></td>
									<td><strong>{{ rule.basePokemon|title }}</strong></td>
									<td style="text-align: center; color: var(--text-secondary);"><i class="fa-solid fa-right-long"></i></td>
									<td><img src="{{ evolvedSprite }}" alt="{{ rule.evolvedPokemon }}" style="width: 40px; height: 40px; object-fit: contain;" onerror="this.style.opacity='0.2'"></td>
									<td><strong>{{ rule.evolvedPokemon|title }}</strong></td>
									<td>
										<span class="admin-hero-badge" style="background: rgba(16,185,129,0.15); color: #34d399; font-size: 0.85rem; padding: 4px 10px;">
											{{ rule.method }} {% if rule.gender == 'male' %}- Macho{% elseif rule.gender == 'female' %}- Fêmea{% endif %}
										</span>
									</td>
									<td class="text-right">
										<form method="post" action="{{ path('app_admin_evolution_rule_delete', {'id': rule.id}) }}" onsubmit="return confirm('Remover esta regra de evolução?')">
											<button type="submit" class="btn-admin-reject btn-sm" style="padding: 6px 12px; font-size: 0.8rem;">
												<i class="fa-solid fa-trash-can"></i> Remover
											</button>
										</form>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="7">
										<div class="admin-empty-placeholder">
											<i class="fa-solid fa-circle-info info-icon"></i> Nenhuma regra de evolução customizada cadastrada.
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			<!-- ===================================================================
			     ABA 6: GOLPES BASE PADRÃO
			     =================================================================== -->
			<div class="dash-panel" id="panel-basemoves">
				<div class="admin-card-container padded">
					<h3 class="admin-section-title mb-15">Adicionar ou Editar Golpes Base Padrão</h3>
					<form method="post" action="{{ path('app_admin_default_base_moves_save') }}">
						<div class="title-form-grid admin-grid-3" style="grid-template-columns: 1fr 2fr auto;">
							<div>
								<label class="title-form-label">Pokémon *</label>
								<input type="text" name="pokemon" class="form-input" list="evolution-pokemon-list" placeholder="Ex: bulbasaur" required autocomplete="off">
							</div>
							<div>
								<label class="title-form-label">Golpes (Separados por vírgula) *</label>
								<input type="text" name="moves" class="form-input" placeholder="Ex: tackle, growl, vine-whip" required autocomplete="off">
							</div>
							<div style="display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 5px;">
								<label class="title-form-checkbox-label" style="margin-bottom: 8px;">
									<input type="checkbox" name="overwrite" value="1" class="admin-checkbox">
									Sobrescrever existentes?
								</label>
							</div>
						</div>
						<div class="title-form-footer">
							<span class="text-muted" style="font-size: 0.8rem; color: var(--text-muted);">
								<i class="fa-solid fa-circle-info"></i> Deixe desmarcado para apenas adicionar novos golpes.
							</span>
							<button type="submit" class="btn btn-primary">
								<i class="fa-solid fa-floppy-disk"></i> Salvar Golpes
							</button>
						</div>
					</form>
				</div>

				<div class="admin-card-container padded">
					<input type="text" id="base-moves-search" onkeyup="filterBaseMoves()" placeholder="Buscar por Pokémon ou Golpe..." class="form-input" style="width: 100%;">
				</div>

				<div class="admin-card-container overflow-hidden">
					<table class="admin-table" id="base-moves-table">
						<thead>
							<tr>
								<th style="width: 60px;">Sprite</th>
								<th style="width: 200px;">Pokémon</th>
								<th>Golpes Base Cadastrados</th>
								<th class="text-right" style="width: 150px;">Ações</th>
							</tr>
						</thead>
						<tbody id="base-moves-tbody">
							{% for pkmName, moves in defaultBaseMoves %}
								{% set pkm = pokemonByName[pkmName]|default(null) %}
								{% set spriteUrl = pkm ? pkm.sprite : 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/0.png' %}
								
								<tr class="base-moves-row" data-search="{{ pkmName }} {{ moves|join(' ') }}">
									<td><img src="{{ spriteUrl }}" alt="{{ pkmName }}" style="width: 40px; height: 40px; object-fit: contain;" onerror="this.style.opacity='0.2'"></td>
									<td><strong>{{ pkmName|title }}</strong></td>
									<td>
										<div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
											{% for m in moves %}
												<span class="admin-hero-badge" style="background: rgba(59,130,246,0.15); color: #60a5fa; font-size: 0.8rem; padding: 4px 8px; display: inline-flex; align-items: center; gap: 6px;">
													{{ m|replace({'-': ' '})|title }}
													<form method="post" action="{{ path('app_admin_default_base_moves_delete') }}" style="display: inline-block; margin: 0;">
														<input type="hidden" name="pokemon" value="{{ pkmName }}">
														<input type="hidden" name="move" value="{{ m }}">
														<button type="submit" style="background: none; border: none; padding: 0; color: #fca5a5; cursor: pointer; display: inline-flex; align-items: center;" title="Remover golpe">
															<i class="fa-solid fa-circle-xmark" style="font-size: 0.85rem;"></i>
														</button>
													</form>
												</span>
											{% endfor %}
										</div>
									</td>
									<td class="text-right">
										<form method="post" action="{{ path('app_admin_default_base_moves_delete') }}" onsubmit="return confirm('Remover TODOS os golpes base de {{ pkmName|title }}?')">
											<input type="hidden" name="pokemon" value="{{ pkmName }}">
											<button type="submit" class="btn-admin-reject btn-sm" style="padding: 6px 12px; font-size: 0.8rem;">
												<i class="fa-solid fa-trash-can"></i> Remover Tudo
											</button>
										</form>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="4">
										<div class="admin-empty-placeholder">
											<i class="fa-solid fa-circle-info info-icon"></i> Nenhum Pokémon configurado.
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			<!-- ===================================================================
			     ABA 7: GAMIFICAÇÃO & CARDS
			     =================================================================== -->
			<div class="dash-panel" id="panel-gamification">
				<div class="overview-actions-grid">
					<div class="action-card">
						<div class="action-card-header">
							<i class="fa-solid fa-image"></i>
							<h3>Planos de Fundo (Card Templates)</h3>
						</div>
						<p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
							Sincronize ou resete o catálogo de imagens de fundos de cartão de treinador diretamente da API.
						</p>
						<div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto;">
							<form method="post" action="{{ path('app_admin_templates_sync') }}" style="flex: 1;">
								<button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; font-size: 0.85rem;">
									<i class="fa-solid fa-rotate"></i> Sincronizar
								</button>
							</form>
							<form method="post" action="{{ path('app_admin_templates_reset') }}" onsubmit="return confirm('Deseja realmente resetar o banco de templates?')" style="flex: 1;">
								<button type="submit" class="btn btn-secondary" style="width: 100%; justify-content: center; font-size: 0.85rem; background: rgba(239, 68, 68, 0.15); color: #fca5a5; border-color: rgba(239, 68, 68, 0.3);">
									<i class="fa-solid fa-power-off"></i> Resetar
								</button>
							</form>
						</div>
					</div>

					<div class="action-card">
						<div class="action-card-header">
							<i class="fa-solid fa-user-ninja"></i>
							<h3>Avatares de Treinador</h3>
						</div>
						<p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
							Sincronize ou resete os avatares de treinador disponíveis na plataforma.
						</p>
						<div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto;">
							<form method="post" action="{{ path('app_admin_avatars_sync') }}" style="flex: 1;">
								<button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; font-size: 0.85rem;">
									<i class="fa-solid fa-rotate"></i> Sincronizar
								</button>
							</form>
							<form method="post" action="{{ path('app_admin_avatars_reset') }}" onsubmit="return confirm('Deseja realmente resetar o banco de avatares?')" style="flex: 1;">
								<button type="submit" class="btn btn-secondary" style="width: 100%; justify-content: center; font-size: 0.85rem; background: rgba(239, 68, 68, 0.15); color: #fca5a5; border-color: rgba(239, 68, 68, 0.3);">
									<i class="fa-solid fa-power-off"></i> Resetar
								</button>
							</form>
						</div>
					</div>
				</div>

				<!-- Tabela de Card Templates Existentes -->
				{% if cardTemplates is defined and cardTemplates is not empty %}
					<div class="admin-card-container overflow-hidden" id="card-templates-section" style="margin-top: 15px;">
						<div class="padded" style="border-bottom: 1px solid var(--dash-border);">
							<h3 class="admin-section-title">Requisitos de Card Templates ({{ cardTemplates|length }})</h3>
						</div>
						<table class="admin-table">
							<thead>
								<tr>
									<th style="width: 80px;">Prévia</th>
									<th>Nome</th>
									<th>Regra de Requisito</th>
									<th>Padrão?</th>
									<th class="text-right" style="width: 150px;">Ações</th>
								</tr>
							</thead>
							<tbody>
								{% for tpl in cardTemplates %}
									{% set tplImgUrl = (tpl.image starts with 'http') ? tpl.image : 'https://raw.githubusercontent.com/thiago9852/pokemon-sprite/main/sprites/src/templates/' ~ tpl.image %}
									<tr>
										<td>
											<img src="{{ tplImgUrl }}" alt="{{ tpl.name }}" style="width: 60px; height: 35px; object-fit: cover; border-radius: 4px; border: 1px solid var(--dash-border);" onerror="this.style.opacity='0.2'">
										</td>
										<td><strong>{{ tpl.name }}</strong></td>
										<td>{{ tpl.requirement|default('Nenhum') }}</td>
										<td>
											{% if tpl.isDefault %}
												<span class="title-status-icon success"><i class="fa-solid fa-circle-check"></i> Sim</span>
											{% else %}
												<span class="text-muted">Não</span>
											{% endif %}
										</td>
										<td class="text-right">
											{% if not tpl.isDefault %}
												<form method="post" action="{{ path('app_admin_card_template_delete', {'id': tpl.id}) }}" onsubmit="return confirm('Remover este template?')">
													<button type="submit" class="btn-admin-reject btn-sm" style="padding: 6px 12px; font-size: 0.8rem;">
														<i class="fa-solid fa-trash-can"></i> Excluir
													</button>
												</form>
											{% endif %}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endif %}
			</div>

		</main>
	</div>
{% endblock %}

{% block javascripts %}
	<script>
		// Alternador de Abas do Dashboard
		window.switchDashTab = function(tabId) {
			document.querySelectorAll('.dash-panel').forEach(panel => panel.classList.remove('active'));
			document.querySelectorAll('.dash-nav-item').forEach(item => item.classList.remove('active'));

			const targetPanel = document.getElementById('panel-' + tabId);
			const targetNavItem = document.getElementById('nav-' + tabId);

			if (targetPanel) targetPanel.classList.add('active');
			if (targetNavItem) targetNavItem.classList.add('active');

			const titles = {
				'overview': 'Visão Geral & Dashboard',
				'locations': 'Moderação de Localizações',
				'movesets': 'Validação de Movesets',
				'variations': 'Variações de Pokémon',
				'evolutions': 'Regras de Evolução',
				'basemoves': 'Golpes Base Padrão',
				'gamification': 'Gamificação & Avatares'
			};
			const titleEl = document.getElementById('dash-header-title-text');
			if (titleEl && titles[tabId]) {
				titleEl.textContent = titles[tabId];
			}

			if (history.pushState) {
				history.pushState(null, null, '#' + tabId);
			} else {
				location.hash = '#' + tabId;
			}

			closeMobileSidebar();
		};

		window.toggleMobileSidebar = function() {
			const sidebar = document.getElementById('dash-sidebar');
			const overlay = document.getElementById('dash-sidebar-overlay');
			if (sidebar && overlay) {
				sidebar.classList.toggle('open');
				overlay.classList.toggle('active');
			}
		};

		window.closeMobileSidebar = function() {
			const sidebar = document.getElementById('dash-sidebar');
			const overlay = document.getElementById('dash-sidebar-overlay');
			if (sidebar && overlay) {
				sidebar.classList.remove('open');
				overlay.classList.remove('active');
			}
		};

		document.addEventListener('DOMContentLoaded', function() {
			let initialTab = '{{ activeTab }}';
			if (window.location.hash) {
				const hashTab = window.location.hash.replace('#', '');
				if (['overview', 'locations', 'movesets', 'variations', 'evolutions', 'basemoves', 'gamification'].includes(hashTab)) {
					initialTab = hashTab;
				}
			}
			if (!initialTab || initialTab === 'users' || initialTab === 'games') {
				if (initialTab === 'users' || initialTab === 'games') {
					initialTab = 'locations';
				} else {
					initialTab = 'overview';
				}
			}
			switchDashTab(initialTab);

			// Seleção em lote de sugestões de usuários
			const selectAllSuggestions = document.getElementById('selectAllSuggestions');
			if (selectAllSuggestions) {
				selectAllSuggestions.addEventListener('change', function () {
					const checkboxes = document.querySelectorAll('.suggestion-checkbox');
					checkboxes.forEach(cb => cb.checked = this.checked);
				});
			}

			// Seleção em lote de localizações oficiais (API)
			const selectAllGameLocs = document.getElementById('selectAllGameLocs');
			if (selectAllGameLocs) {
				selectAllGameLocs.addEventListener('change', function () {
					const checkboxes = document.querySelectorAll('.game-loc-checkbox');
					checkboxes.forEach(cb => cb.checked = this.checked);
				});
			}

			// Seleção em lote de sugestões de moveset
			const selectAllMovesets = document.getElementById('selectAllMovesets');
			if (selectAllMovesets) {
				selectAllMovesets.addEventListener('change', function () {
					const checkboxes = document.querySelectorAll('.moveset-checkbox');
					checkboxes.forEach(cb => cb.checked = this.checked);
				});
			}
		});

		// Filtros locais em tempo real
		window.filterVariations = function () {
			const q = document.getElementById('variation-search').value.toLowerCase().trim();
			document.querySelectorAll('.variation-row').forEach(row => {
				row.style.display = row.dataset.search.toLowerCase().includes(q) ? '' : 'none';
			});
		};

		window.toggleCustomStoneField = function (val) {
			const customField = document.getElementById('custom-stone-field');
			if (customField) {
				customField.style.display = val === 'custom' ? 'block' : 'none';
				if (val === 'custom') {
					customField.setAttribute('required', 'required');
				} else {
					customField.removeAttribute('required');
				}
			}
		};

		window.filterEvolutionRules = function () {
			const q = document.getElementById('evolution-search').value.toLowerCase().trim();
			document.querySelectorAll('.evolution-row').forEach(row => {
				row.style.display = row.dataset.search.toLowerCase().includes(q) ? '' : 'none';
			});
		};

		window.filterBaseMoves = function () {
			const q = document.getElementById('base-moves-search').value.toLowerCase().trim();
			document.querySelectorAll('.base-moves-row').forEach(row => {
				row.style.display = row.dataset.search.toLowerCase().includes(q) ? '' : 'none';
			});
		};
	</script>
{% endblock %}
